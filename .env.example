# ── Live in-browser Macky voice demo ─────────────────────────────────────────
# All values here are PUBLIC (they ship in the client bundle). No secrets belong
# in the website — the Azure key and Turnstile secret live only in the Worker.

# Cloudflare Turnstile SITE key (public). Get it from the Turnstile dashboard for
# the widget created on the realtime-proxy Worker's Cloudflare account. Leave the
# default test key for local dev only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Base URL of the realtime-proxy Worker. Override only if pointing at a preview
# deployment; the default is the production Worker.
NEXT_PUBLIC_DEMO_WORKER_BASE=https://realtime-proxy.winky-secrets.workers.dev

# Supabase (server-only). Used by /api/waitlist to store early-access emails.
# Create the table with supabase/waitlist.sql, then paste Project URL + service
# role key from Supabase → Project Settings → API. Leave unset and the site will
# explain that early access is not open yet.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
